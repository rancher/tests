# Lean Dockerfile for Infrastructure Operations
# Contains only essentials for running Ansible, Tofu, and AWS
FROM --platform=linux/amd64 alpine:3.22@sha256:e0baf8c394150ac5a14925e179100519f5e37c53547f647acbd9f8eb3e5c4528

ARG TOFU_VERSION=1.10.7
ARG AWSCLI_VERSION=1.44.44

ARG KUBECTL_VERSION=1.32.3
ARG HELM_VERSION=3.17.3

# qa-infra-automation ref whose requirements.yml Ansible collection pins this
# image installs (single source of truth; the build context has no checkout)
ARG QA_INFRA_REF=main

# Install runtime dependencies
RUN apk add --no-cache \
    bash \
    curl \
    git \
    make \
    openssh-client \
    python3 \
    py3-pip \
    ca-certificates \
    ansible \
    && ln -sf /bin/bash /usr/bin/bash \
    && rm -rf /var/cache/apk/*

# Install OpenTofu
RUN cd /tmp && \
    TOFU_TAR="tofu_${TOFU_VERSION}_linux_amd64.tar.gz" && \
    curl -Lo "${TOFU_TAR}" "https://github.com/opentofu/opentofu/releases/download/v${TOFU_VERSION}/${TOFU_TAR}" && \
    curl -Lo tofu_SHA256SUMS "https://github.com/opentofu/opentofu/releases/download/v${TOFU_VERSION}/tofu_${TOFU_VERSION}_SHA256SUMS" && \
    grep "${TOFU_TAR}$" tofu_SHA256SUMS > tofu.sha256 && \
    test -s tofu.sha256 && \
    sha256sum -c tofu.sha256 && \
    rm tofu.sha256 && \
    tar -xzf "${TOFU_TAR}" -C /usr/local/bin/ && \
    rm "${TOFU_TAR}" tofu_SHA256SUMS && \
    chmod +x /usr/local/bin/tofu

# The cloud.terraform tf_output lookup (used by qa-infra playbooks with a local
# tfstate) requires a `terraform` binary on PATH; this image ships OpenTofu
RUN ln -sf /usr/local/bin/tofu /usr/local/bin/terraform

# Install AWS CLI + Python libraries required by the Ansible collections
# (kubernetes for kubernetes.core, boto3 for amazon.aws e.g. s3_object)
RUN pip3 install --no-cache-dir --break-system-packages awscli==${AWSCLI_VERSION} kubernetes boto3

# Install the Ansible collections pinned by qa-infra-automation. Fetched from
# the repo instead of duplicating pins: cloud.terraform is absent from the
# alpine ansible bundle and bundled versions drift from the pins.
RUN curl -fsSL -o /tmp/requirements.yml \
      "https://raw.githubusercontent.com/rancher/qa-infra-automation/${QA_INFRA_REF}/requirements.yml" \
    && ansible-galaxy collection install -r /tmp/requirements.yml \
    && rm -f /tmp/requirements.yml

# Install kubectl
RUN curl -Lo /usr/local/bin/kubectl "https://dl.k8s.io/release/v${KUBECTL_VERSION}/bin/linux/amd64/kubectl" \
    && chmod +x /usr/local/bin/kubectl

# Install Helm
RUN curl -Lo /tmp/helm.tar.gz "https://get.helm.sh/helm-v${HELM_VERSION}-linux-amd64.tar.gz" \
    && tar -xzf /tmp/helm.tar.gz -C /tmp/ \
    && mv /tmp/linux-amd64/helm /usr/local/bin/helm \
    && rm -rf /tmp/helm.tar.gz /tmp/linux-amd64

# Create working directory
WORKDIR /workspace

# Verify installations
RUN tofu version && \
    make --version && \
    ansible --version && \
    ansible-galaxy collection list | grep -q cloud.terraform && \
    aws --version && \
    kubectl version --client && \
    helm version

# Default to sh shell (compatible with alpine and docker run sh -c)
CMD ["/bin/sh"]
